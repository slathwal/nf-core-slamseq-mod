/*
 * -------------------------------------------------
 *  nf-core/slamseq Nextflow base config file
 * -------------------------------------------------
 * A 'blank slate' config file, appropriate for general
 * use on most high performace compute environments.
 * Assumes that all software is installed and available
 * on the PATH. Runs in `local` mode - all jobs will be
 * run on the logged in environment.
 */

process {

  // Cap every resource request at the configured maxima (replaces the old
  // check_max() helper; Nextflow silently caps requests above these limits).
  resourceLimits = [
    cpus:   params.max_cpus,
    memory: params.max_memory,
    time:   params.max_time
  ]

  cpus = { 1 * task.attempt }
  memory = { 8.GB * task.attempt }
  time = { 2.h * task.attempt }

  errorStrategy = { task.exitStatus in [143,137,104,134,139] ? 'retry' : 'finish' }
  maxRetries = 1
  maxErrors = '-1'

  withLabel: slamdunk_process {
    cpus = 1
    memory = { 10.GB * task.attempt }
    time = { 8.h * task.attempt }
  }

  withName: TRIM_GALORE {
    cpus = { 4 * task.attempt }
    memory = { 10.GB * task.attempt }
    time = { 2.h * task.attempt }
  }
  withName: SLAMDUNK_MAP {
    cpus = { 14 * task.attempt }
    memory = { 30.GB * task.attempt }
    time = { 8.h * task.attempt }
  }
  withName: SLAMDUNK_SNP {
    cpus = 2
    memory = { 10.GB * task.attempt }
    time = { 8.h * task.attempt }
  }
  withName: ALLEYOOP_SUMMARY {
    cpus = 1
    memory = { 1.GB * task.attempt }
    time = { 1.h * task.attempt }
  }
  withName: MULTIQC {
    errorStrategy = { task.exitStatus in [143,137] ? 'retry' : 'ignore' }
  }
  withName: GET_SOFTWARE_VERSIONS {
    cache = false
  }
}

params {
  // Defaults only, expecting to be overwritten
  max_memory = 128.GB
  max_cpus = 24
  max_time = 240.h
}
